import random

# 1. 建立名單 (根據夏1_2座位表PDF) [cite: 2]
names = [
    "20黃柏瑞", "14郭承叡", "3吳亭葦", "7宋禹潔", "15張谷杉",
    "5吳瑾瑜", "9李忻", "29顏子旅", "10李維", "17張楚楚", "16陳永軍",
    "26劉樂", "1吳采軒", "18游朝翔", "22黃翔澤", "21陳彥寧", "25葉明寬",
    "11李沁恩", "24劉品佑", "23黃祺方", "2任為謙", "30黨宜安", "27謝欣妤",
    "13林霏", "8李羿宸", "4吳元希", "12洪軒平", "28簡向晨"
]

# 2. 隨機打亂
random.shuffle(names)

# 3. 座位設置佈局 (第一排5人，中間各6人，末排5人) [cite: 2]
layout = [5, 6, 6, 6, 5]

print("========== 夏1_2 隨機座位表 (Python 版) ==========")
print("              [ 講 台 ]\n")

current = 0
# 使用迴圈根據佈局將名單分排印出
for i, count in enumerate(layout):
    row_list = []
    for _ in range(count):
        if current < len(names):
            row_list.append(names[current])
            current += 1
    
    # 印出每一排，使用 tab 鍵 (\t) 讓名字對齊
    print(f"第 {i+1} 排: " + "\t".join(row_list))

print("\n================================================")
